\ No newline at end of file
+
+# --- Datasource: every value can be overridden by an environment variable (12-factor).
+# Defaults keep the original local-dev behaviour (MySQL on localhost, root, empty password).
+spring.datasource.url=${DB_URL:jdbc:mysql://localhost:3306/mydb?serverTimezone=UTC&createDatabaseIfNotExist=true}
+spring.datasource.username=${DB_USERNAME:root}
+spring.datasource.password=${DB_PASSWORD:}
+
+# Driver and dialect are auto-detected from the URL (keeps the H2 test profile working).
+# 'update' is fine for local dev; in Kubernetes use validate/none + a migration tool (milestone M7).
+spring.jpa.hibernate.ddl-auto=${DDL_AUTO:update}
+
+# --- Server: finish in-flight requests on SIGTERM (needed for zero-downtime rollouts).
+server.port=${PORT:8080}
+server.shutdown=graceful
+spring.lifecycle.timeout-per-shutdown-phase=20s
+
+# --- Actuator: probes + metrics on a SEPARATE port so the ingress never exposes them.
+management.server.port=${MANAGEMENT_PORT:8081}
+management.endpoints.web.exposure.include=health,info,prometheus
+management.endpoint.health.probes.enabled=true
+management.endpoint.health.show-details=never
+# Liveness must NOT depend on the database (otherwise a DB blip restarts every pod).
+# Readiness should: do not receive traffic when the DB is unreachable.
+management.endpoint.health.group.readiness.include=readinessState,db
+management.metrics.tags.application=${spring.application.name}
